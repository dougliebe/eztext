{
  "name": "eztext",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A workbench for applying overlapping text-analysis extensions to a document.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "ui-check": "node scripts/ui-check.mjs",
    "corpus:norms": "node scripts/build-corpus-norms.mjs",
    "model": "node scripts/model-server.mjs",
    "model:norms": "node scripts/build-surprisal-norms.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
